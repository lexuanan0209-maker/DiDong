<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:theme="@style/Theme.AppCompat.Light.NoActionBar"> <!-- Dòng này giúp khung Preview render chuẩn FloatingActionButton -->

    <LinearLayout
        android:id="@+id/layoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etTimKiemSuKien"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Tìm tên hoặc mã sự kiện..."
            android:minHeight="48dp"
            android:padding="10dp"
            android:textSize="14sp"
            tools:ignore="Autofill,HardcodedText,TextContrastCheck,TextFields,VisualLintTextFieldSize,VisualLintSystemUi,TouchTargetSizeCheck,VisualLintBounds" />

        <Spinner
            android:id="@+id/spSapXepSuKien"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:entries="@array/danh_sach_sap_xep_su_kien"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuKien"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTop"
        android:layout_above="@id/fabTaoSuKien" />

    <TextView
        android:id="@+id/tvKhongCoSuKien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="không có sự kiện nào được tạo"
        android:textSize="16sp"
        android:textColor="#888888"
        android:layout_centerInParent="true"
        android:visibility="gone"
        tools:ignore="HardcodedText" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTaoSuKien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="#FFFFFF"
        android:contentDescription="Tạo sự kiện mới"
        tools:ignore="HardcodedText,ImageContrastCheck,SpeakableTextPresentCheck" />
</RelativeLayout>